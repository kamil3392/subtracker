---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
// Inline text links: the `link` variant's colour and focus ring without the button box.
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-border bg-card px-4 py-2 text-sm text-card-foreground shadow-sm">
  {user ? (
    <>
      <span class="min-w-0 truncate text-muted-foreground">{user.email}</span>
      <div class="flex shrink-0 items-center gap-3">
        <a href="/dashboard" class:list={linkClass}>
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={linkClass}>
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class:list={linkClass}>
          Sign in
        </a>
        <a href="/auth/signup" class:list={linkClass}>
          Sign up
        </a>
      </div>
    </>
  )}
</div>

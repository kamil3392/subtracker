---
import { CalendarClock, Lock, Wallet } from "lucide-react";
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
---

<div class="min-h-screen w-full">
  <div class="p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-6 text-5xl leading-tight font-bold text-foreground sm:text-6xl lg:text-7xl">SUBTRACKER</h1>
      <p class="mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
        All your subscriptions in one place: monthly, quarterly and yearly charges turned into one real monthly cost,
        with every renewal coming up in the next 30 days.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>
          Sign In
        </a>
        <a href="/auth/signup" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
          Sign Up
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <Card>
        <CardContent>
          <Wallet className="mb-4 size-6 text-primary" aria-hidden="true" />
          <h3 class="mb-2 text-lg font-semibold text-foreground">Real monthly cost</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Every billing cycle is converted to a monthly amount and summed separately for each currency.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardContent>
          <CalendarClock className="mb-4 size-6 text-primary" aria-hidden="true" />
          <h3 class="mb-2 text-lg font-semibold text-foreground">Upcoming renewals</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            See what renews in the next 30 days before the charge hits your card statement.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardContent>
          <Lock className="mb-4 size-6 text-primary" aria-hidden="true" />
          <h3 class="mb-2 text-lg font-semibold text-foreground">Private by default</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Your subscriptions are visible only to your account — no one else can see them.
          </p>
        </CardContent>
      </Card>
    </div>
  </div>
</div>

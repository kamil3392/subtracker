---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { cn } from "@/lib/utils";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
// Inline text link: the `link` variant's colour and focus ring without the button box.
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center">
      <CardContent>
        <div class="mb-4 text-5xl">{content.emoji}</div>
        <h1 class="mb-3 text-2xl font-bold text-foreground">{content.heading}</h1>
        <p class="mb-6 text-muted-foreground">{content.description}</p>
        <a href="/auth/signin" class:list={linkClass}>
          {content.linkText}
        </a>
      </CardContent>
    </Card>
  </div>
</Layout>

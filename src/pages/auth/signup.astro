---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { cn } from "@/lib/utils";

const error = Astro.url.searchParams.get("error");
// Inline text link: the `link` variant's colour and focus ring without the button box.
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<Layout title="Sign up">
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <h1 class="text-center text-2xl font-bold text-foreground">Sign up</h1>
      </CardHeader>
      <CardContent>
        <SignUpForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-muted-foreground">
          Already have an account?{" "}
          <a href="/auth/signin" class:list={linkClass}>
            Sign in
          </a>
        </p>
      </CardContent>
    </Card>
  </div>
</Layout>

---
import Topbar from "@/components/Topbar.astro";
import SubscriptionForm from "@/components/subscriptions/SubscriptionForm";
import Layout from "@/layouts/Layout.astro";
import { BILLING_CYCLE_LABELS } from "@/lib/currencies";
import { todayInWarsaw } from "@/lib/services/dates";
import {
  countsToward,
  effectiveRenewalDate,
  monthlyCostByCurrency,
  upcomingRenewals,
} from "@/lib/services/subscriptions";
import { formValuesFromSearchParams } from "@/lib/subscription-form";
import { createClient } from "@/lib/supabase";
import type { Subscription } from "@/types";

const error = Astro.url.searchParams.get("error");
// F6: after a failed add the endpoint carries the typed values back in the query string.
const initialValues = error ? formValuesFromSearchParams(Astro.url.searchParams) : undefined;

let subscriptions: Subscription[] = [];
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase is not configured, so subscriptions cannot be loaded.";
} else {
  // RLS restricts the select to the signed-in owner's rows.
  const { data, error: selectError } = await supabase.from("subscriptions").select("*");
  if (selectError) {
    loadError = "Could not load your subscriptions. Please try again later.";
  } else {
    subscriptions = data;
  }
}

const today = todayInWarsaw(new Date());
const costs = monthlyCostByCurrency(subscriptions, today);
const renewals = upcomingRenewals(subscriptions, today);
// The empty state means "no entries at all"; entries that no longer count (FR-007) still show the list.
const isEmpty = subscriptions.length === 0;
// FR-004: every entry from the rows already loaded (no extra query), sorted by name.
const allSubscriptions = [...subscriptions].sort((a, b) => a.name.localeCompare(b.name));

function formatMoney(amount: number, currency: string): string {
  return new Intl.NumberFormat("pl-PL", { style: "currency", currency }).format(amount);
}

// Calendar dates are `YYYY-MM-DD`; format them in UTC so no timezone shift moves the day.
const dateFormat = new Intl.DateTimeFormat("pl-PL", { dateStyle: "long", timeZone: "UTC" });
function formatDate(date: string): string {
  return dateFormat.format(new Date(`${date}T00:00:00Z`));
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 py-6 text-white lg:grid-cols-[1fr_22rem]">
        <div class="space-y-6">
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Your subscriptions
          </h1>

          {loadError ? (
            <p class="rounded-xl border border-red-500/30 bg-red-900/30 px-4 py-3 text-sm text-red-300">{loadError}</p>
          ) : isEmpty ? (
            <section class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
              <h2 class="mb-2 text-lg font-semibold">No subscriptions yet</h2>
              <p class="text-sm text-blue-100/60">
                Add your first subscription with the form to see your monthly cost and upcoming renewals.
              </p>
            </section>
          ) : (
            <>
              <section>
                <h2 class="mb-3 text-lg font-semibold">Monthly cost</h2>
                {costs.length === 0 ? (
                  <p class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-blue-100/60">
                    No subscriptions count toward your monthly cost right now.
                  </p>
                ) : (
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {costs.map(({ currency, monthlyCents }) => (
                      <div class="rounded-xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
                        <p class="text-sm text-blue-100/60">{currency} per month</p>
                        <p class="mt-1 text-2xl font-bold">{formatMoney(monthlyCents / 100, currency)}</p>
                      </div>
                    ))}
                  </div>
                )}
              </section>

              <section>
                <h2 class="mb-3 text-lg font-semibold">Renewals in the next 30 days</h2>
                {renewals.length === 0 ? (
                  <p class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-blue-100/60">
                    No renewals in the next 30 days.
                  </p>
                ) : (
                  <ul class="divide-y divide-white/10 rounded-xl border border-white/10 bg-white/5 backdrop-blur-xl">
                    {renewals.map(({ subscription, renewalDate }) => (
                      <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                        <div>
                          <p class="font-medium">{subscription.name}</p>
                          <p class="text-sm text-blue-100/60">
                            {formatDate(renewalDate)} ·{" "}
                            {subscription.status === "cancelled"
                              ? "Cancelled, won't renew"
                              : BILLING_CYCLE_LABELS[subscription.billing_cycle]}
                          </p>
                        </div>
                        <p class="font-semibold">{formatMoney(subscription.price, subscription.currency)}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            </>
          )}

          {!loadError && allSubscriptions.length > 0 && (
            <section>
              <h2 class="mb-3 text-lg font-semibold">All subscriptions</h2>
              <ul class="divide-y divide-white/10 rounded-xl border border-white/10 bg-white/5 backdrop-blur-xl">
                {allSubscriptions.map((subscription) => (
                  <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                    <div>
                      <p class="font-medium">{subscription.name}</p>
                      <p class="text-sm text-blue-100/60">
                        {formatMoney(subscription.price, subscription.currency)} ·{" "}
                        {BILLING_CYCLE_LABELS[subscription.billing_cycle]}
                      </p>
                      <p class="text-sm text-blue-100/60">
                        {subscription.status === "active"
                          ? `Next renewal: ${formatDate(effectiveRenewalDate(subscription, today))}`
                          : `Cancelled · ${countsToward(subscription, today) ? "ends" : "ended"} ${formatDate(effectiveRenewalDate(subscription, today))}`}
                      </p>
                    </div>
                    <a
                      href={`/subscriptions/${subscription.id}/edit`}
                      class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                    >
                      Edit
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <section class="h-fit rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
          <h2 class="mb-4 text-lg font-semibold">Add subscription</h2>
          <SubscriptionForm
            action="/api/subscriptions"
            submitLabel="Add subscription"
            pendingText="Saving..."
            submitIcon="plus"
            initialValues={initialValues}
            serverError={error}
            client:load
          />
        </section>
      </div>
    </div>
  </div>
</Layout>

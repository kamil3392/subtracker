---
import DashboardView from "@/components/dashboard/DashboardView.astro";
import Layout from "@/layouts/Layout.astro";
import { todayInWarsaw } from "@/lib/services/dates";
import { FORM_VALUE_MAX_LENGTH, formValuesFromSearchParams } from "@/lib/subscription-form";
import { createClient } from "@/lib/supabase";
import type { Subscription } from "@/types";

// The query string is user-controlled; cap the message like the carried form values.
const error = Astro.url.searchParams.get("error")?.slice(0, FORM_VALUE_MAX_LENGTH) ?? null;
// F6: after a failed add the endpoint carries the typed values back in the query string.
const carriedValues = error ? formValuesFromSearchParams(Astro.url.searchParams) : undefined;
// F4: an error without carried fields did not come from `formErrorLocation` (the add form), so it is
// an action on an entry (edit, cancel, delete) and is shown as a page-level banner, not in the form.
const isPageError = carriedValues !== undefined && Object.keys(carriedValues).length === 0;
const pageError = isPageError ? error : null;
const formError = isPageError ? null : error;
const initialValues = isPageError ? undefined : carriedValues;

let subscriptions: Subscription[] = [];
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase is not configured, so subscriptions cannot be loaded.";
} else {
  // RLS restricts the select to the signed-in owner's rows.
  const { data, error: selectError } = await supabase.from("subscriptions").select("*");
  if (selectError) {
    loadError = "Could not load your subscriptions. Please try again later.";
  } else {
    subscriptions = data;
  }
}

const today = todayInWarsaw(new Date());
---

<Layout title="Dashboard">
  <DashboardView
    pageError={pageError}
    loadError={loadError}
    subscriptions={subscriptions}
    today={today}
    formError={formError}
    initialValues={initialValues}
  />
</Layout>

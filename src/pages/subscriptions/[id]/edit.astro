---
import Topbar from "@/components/Topbar.astro";
import SubscriptionForm from "@/components/subscriptions/SubscriptionForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { todayInWarsaw } from "@/lib/services/dates";
import { effectiveRenewalDate } from "@/lib/services/subscriptions";
import { formValuesFromSearchParams } from "@/lib/subscription-form";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";
import { parseSubscriptionId } from "@/lib/validation/subscription";
import type { Subscription, SubscriptionFormValues } from "@/types";

const error = Astro.url.searchParams.get("error");
const id = parseSubscriptionId(Astro.params.id);

let subscription: Subscription | null = null;
let loadError: string | null = null;

if (id) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    loadError = "Supabase is not configured, so subscriptions cannot be loaded.";
  } else {
    // RLS restricts the select to the signed-in owner's rows, so another account's id reads as "not found".
    const { data, error: selectError } = await supabase.from("subscriptions").select("*").eq("id", id).maybeSingle();
    if (selectError) {
      loadError = "Could not load your subscriptions. Please try again later.";
    } else {
      subscription = data;
    }
  }
}

const notFound = !loadError && !subscription;
if (notFound) {
  Astro.response.status = 404;
}

let initialValues: Partial<SubscriptionFormValues> | undefined;
if (subscription) {
  // Active entries show the rolled-over date; for a cancelled entry the date field is its end date (FR-007).
  initialValues = {
    name: subscription.name,
    price: subscription.price.toFixed(2),
    currency: subscription.currency,
    billing_cycle: subscription.billing_cycle,
    next_renewal_date: effectiveRenewalDate(subscription, todayInWarsaw(new Date())),
    // F6: after a failed save the endpoint carries the typed values back; they win over the stored row.
    ...(error ? formValuesFromSearchParams(Astro.url.searchParams) : {}),
  };
}

// Inline text links: the `link` variant's colour and focus ring without the button box.
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<Layout title="Edit subscription">
  <div class="min-h-screen w-full p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto max-w-xl space-y-6 py-6">
      <a href="/dashboard" class:list={linkClass}>
        ← Back to dashboard
      </a>

      <h1 class="text-3xl font-bold text-foreground">Edit subscription</h1>

      {loadError ? (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : subscription ? (
        <section>
          <Card>
            <CardContent>
              {subscription.status === "cancelled" && (
                <p class="mb-4 rounded-lg border border-border bg-muted px-3 py-2 text-sm text-muted-foreground">
                  This subscription is cancelled — its end date and billing cycle stay as they are.
                </p>
              )}
              <SubscriptionForm
                action={`/api/subscriptions/${subscription.id}`}
                submitLabel="Save changes"
                pendingText="Saving..."
                submitIcon="save"
                initialValues={initialValues}
                serverError={error}
                client:load
              />
            </CardContent>
          </Card>
        </section>
      ) : (
        <section>
          <Card className="text-center">
            <CardContent>
              <h2 class="mb-2 text-lg font-semibold">Subscription not found</h2>
              <p class="text-sm text-muted-foreground">
                It may have been removed, or it belongs to another account.{" "}
                <a href="/dashboard" class:list={linkClass}>
                  Go to dashboard
                </a>
              </p>
            </CardContent>
          </Card>
        </section>
      )}
    </div>
  </div>
</Layout>

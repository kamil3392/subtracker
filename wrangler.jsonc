{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subtracker",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  // Preview URLs are public by default; keep them off until they are behind Cloudflare Access
  // and pointed at a non-production Supabase project.
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
